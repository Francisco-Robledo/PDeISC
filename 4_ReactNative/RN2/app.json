{
  "expo": {
    "name": "RN2",
    "slug": "rn2",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Esta aplicación necesita acceso a la cámara para capturar fotos y escanear códigos QR y de barras.",
        "NSLocationWhenInUseUsageDescription": "Esta aplicación necesita acceso a la ubicación para mostrar coordenadas GPS y altitud.",
        "NSFaceIDUsageDescription": "Esta aplicación utiliza Face ID para autenticación biométrica."
      }
    },
    "android": {
      "package": "com.anonymous.devicetoolsapp",
      "adaptiveIcon": {
        "backgroundColor": "#0F172A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.VIBRATE",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Permite que DeviceToolsApp use la cámara para fotos y escáner de códigos."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Permite que DeviceToolsApp use la ubicación para telemetría GPS."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Permite autenticación biométrica segura."
        }
      ]
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "9e37e37f-767f-4f1c-931f-7b427457c0c1"
      }
    }
  }
}
